# Environment Variables Template
# Copy this file to .env and update with your actual values

# ============================================================================
# PEAK SYSTEM CONFIGURATION
# ============================================================================
PEAK_ENDPOINT=https://peak-api.example.com
PEAK_API_VERSION=v1
PEAK_USERNAME=your_peak_username
PEAK_PASSWORD=your_peak_password
PEAK_TIMEOUT=30

# ============================================================================
# STORAGE CONFIGURATION
# ============================================================================
SHARED_DRIVE_PATH=\\shared.drive\uwfiles
LOCAL_CACHE_PATH=data/cache

# ============================================================================
# AZURE BLOB STORAGE CONFIGURATION
# ============================================================================
AZURE_STORAGE_ACCOUNT=storageaccount
AZURE_STORAGE_ACCOUNT_KEY=your_azure_storage_key
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
AZURE_CONTAINER_NAME=accufile-reports

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================
SMTP_SERVER=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=accufile@example.com
SMTP_PASSWORD=your_email_password
EMAIL_SENDER=accufile@example.com
OPERATIONS_LEAD_EMAIL=operations.lead@example.com
MANAGEMENT_EMAIL=management@example.com
TECHNICAL_EMAIL=technical@example.com

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
LOG_LEVEL=INFO
LOG_DIR=logs

# ============================================================================
# REPORTING CONFIGURATION
# ============================================================================
REPORT_OUTPUT_PATH=reports/
ENABLE_EMAIL_REPORTS=false
ENABLE_AZURE_ARCHIVE=false

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
ENVIRONMENT=development  # development, staging, production
DEBUG=false
